# Copy to .env (`make .env`) and adjust. Read by docker compose and the Makefile.

# -----------------------------------------------------------------------------
# Docker / compose
# -----------------------------------------------------------------------------
IMAGE=cloudnativegis-processing
TAG=latest
# Host port the API is published on
PORT=8000
# Host directory mounted at /data (for local-path sources)
DATA_DIR=./data

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
# Required as `Authorization: Bearer <token>` on every request except /health.
# Left empty, auth is disabled entirely.
LITE_API_TOKEN=

# -----------------------------------------------------------------------------
# Conversion
# -----------------------------------------------------------------------------
LITE_TMP_DIR=/tmp/cng-lite
# Seconds allowed for downloading a remote source file
LITE_DOWNLOAD_TIMEOUT=60
# Max size (bytes) of a downloaded source file, default 500MB
LITE_MAX_DOWNLOAD_SIZE=524288000
# Max conversions running concurrently in background threads
LITE_JOB_MAX_WORKERS=4
# Seconds a finished, uncollected job result is kept
LITE_JOB_RESULT_TTL=3600

# -----------------------------------------------------------------------------
# S3 / MinIO (for s3://bucket/key sources; left empty, s3:// is rejected)
# -----------------------------------------------------------------------------
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
# 'path' works for MinIO and AWS alike; 'virtual' if needed
S3_ADDRESSING_STYLE=path
S3_PRESIGN_EXPIRY=300
